      ],
      "outcome": [
        [
          "Route",
          "Updated live"
        ],
        [
          "Customer",
          "Auto-notified"
        ],
        [
          "Dispatcher time",
          "None"
        ]
      ]
    },
    {
      "id": "delivery",
      "name": "Delivery confirmation",
