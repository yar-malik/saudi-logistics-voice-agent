  "greeting": {
    "ar": "أهلاً بك، معك ليلى من قسم الشحن. كيف أقدر أساعدك؟",
    "en": "Hello, this is Layla in shipping. How can I help?"
  },
  "flows": [
    {
      "id": "track",
      "name": "Shipment tracking",
      "promise": "“Where is my order?” answered from live tracking, not a guess.",
      "kind": "call",
      "beats": [
        {
          "at": 0.2,
          "kind": "msg",
          "who": "CALLER",
          "ar": "وين شحنتي؟ المفروض توصل أمس.",
          "en": "Where is my shipment? It was due yesterday."
        },
        {
          "at": 2.4,
          "kind": "tool",
          "name": "track_shipment",
          "args": "{ \"awb\": \"AWB-99120\" }",
          "result": "{ \"status\": \"out_for_delivery\", \"eta\": \"today 16:40\", \"delay_reason\": \"customs\" }"
        },
        {
          "at": 4.8,
          "kind": "msg",
          "who": "AGENT",
          "ar": "تأخرت في الجمارك، بس الحين مع المندوب وتوصلك اليوم قبل ٥.",
          "en": "It was held in customs but it is with the driver now, arriving before 5 today."
        },
        {
          "at": 8.2,
          "kind": "tool",
          "name": "subscribe_updates",
          "args": "{ \"channel\": \"whatsapp\" }",
          "result": "{ \"subscribed\": true }"
        }
      ],
      "outcome": [
        [
          "Status",
          "Out for delivery"
        ],
        [
          "Reason",
          "Customs — explained"
        ],
        [
          "Repeat call",
          "Prevented"
        ]
      ]
    },
    {
      "id": "dispatch",
      "name": "Driver dispatch",
      "promise": "The daily calls to drivers, made automatically and written down.",
      "kind": "call",
      "beats": [
        {
          "at": 0.2,
          "kind": "msg",
          "who": "AGENT",
          "ar": "عندك ثلاث توصيلات في شمال الرياض. تقدر تاخذ رابعة؟",
          "en": "You have three drops in north Riyadh. Can you take a fourth?"
        },
        {
          "at": 3.4,
          "kind": "msg",
          "who": "CALLER",
          "ar": "إي أقدر، بس بعد الثانية.",
          "en": "Yes, but after two."
        },
        {
          "at": 5,
          "kind": "tool",
          "name": "assign_route",
          "args": "{ \"driver\": \"D-118\", \"stop\": \"S-4471\", \"after\": \"14:00\" }",
          "result": "{ \"route_updated\": true, \"eta_customer\": \"15:20\" }"
        },
        {
          "at": 7.4,
          "kind": "msg",
          "who": "AGENT",
          "ar": "ضفتها لمسارك، والعميل انبلغ إن الموعد ٣:٢٠.",
          "en": "Added to your route, and the customer has been told 3:20."
